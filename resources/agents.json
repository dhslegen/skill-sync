    "home": { "kind": "home" },
    "cwd": { "kind": "cwd" },
    "configHome": {
      "kind": "env",
      "name": "XDG_CONFIG_HOME",
      "trim": false,
      "default": "{home}/.config"
    },
    "codexHome": { "kind": "env", "name": "CODEX_HOME", "default": "{home}/.codex" },
    "claudeHome": { "kind": "env", "name": "CLAUDE_CONFIG_DIR", "default": "{home}/.claude" },
    "vibeHome": { "kind": "env", "name": "VIBE_HOME", "default": "{home}/.vibe" },
    "hermesHome": { "kind": "env", "name": "HERMES_HOME", "default": "{home}/.hermes" },
    "autohandHome": { "kind": "env", "name": "AUTOHAND_HOME", "default": "{home}/.autohand" },
    "grokHome": { "kind": "env", "name": "GROK_HOME", "default": "{home}/.grok" },
    "appData": { "kind": "env", "name": "APPDATA" },
    "flatpakConfigHome": { "kind": "env", "name": "FLATPAK_XDG_CONFIG_HOME" }
  },
